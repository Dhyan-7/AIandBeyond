    {
      "parameters": {
        "jsCode": "let input = $json.body ?? $json;\nif (typeof input === 'string') {\n  try { input = JSON.parse(input); }\n  catch (e) { return [{ json: { valid: false, message: 'Invalid JSON request body.' } }]; }\n}\nif (!input || typeof input !== 'object' || Array.isArray(input)) {\n  return [{ json: { valid: false, message: 'Invalid form submission.' } }];\n}\nconst fullName = String(input.fullName ?? '').trim();\nconst email = String(input.email ?? '').trim();\nconst phone = String(input.phone ?? '').trim();\nconst course = String(input.course ?? '').trim();\nconst qualification = String(input.qualification ?? '').trim();\nconst admissionYear = String(input.admissionYear ?? '').trim();\nconst message = String(input.message ?? '').trim();\nconst emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!fullName || !email || !phone || !course || !qualification || !admissionYear) {\n  return [{ json: { valid: false, message: 'Please complete all required fields.' } }];\n}\nif (!emailPattern.test(email)) {\n  return [{ json: { valid: false, message: 'Please provide a valid email address.' } }];\n}\nif (!/^[0-9+()\\s-]{8,18}$/.test(phone)) {\n  return [{ json: { valid: false, message: 'Please provide a valid phone number.' } }];\n}\nconst now = new Date();\nconst stamp = now.toISOString().replace(/[-:.TZ]/g, '').slice(0, 14);\nconst random = Math.random().toString(36).slice(2, 6).toUpperCase();\nconst enquiryId = `SSC-${stamp}-${random}`;\nreturn [{\n  json: {\n    valid: true,\n    enquiryId,\n    submittedAt: now.toISOString(),\n    fullName,\n    email,\n    phone,\n    course,\n    qualification,\n    admissionYear,\n    message,\n    source: String(input.source ?? 'Siddaganga College Admission Portal'),\n    enquiryStatus: 'New',\n    emailStatus: 'Pending'\n  }\n}];"
      },
